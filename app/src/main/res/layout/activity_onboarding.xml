<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090E">

    <!-- Top Editorial Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:paddingBottom="14dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:background="#0E131F">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="CLAVIATURA"
                android:fontFamily="monospace"
                android:textSize="18sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="#F8FAFC" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="● INIT WIZARD"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#38BDF8"
                android:background="#152338"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="HARDWARE &amp; SYSTEM IME INITIALIZATION SEQUENCE"
            android:fontFamily="monospace"
            android:textSize="9sp"
            android:letterSpacing="0.05"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Step 1 Section -->
    <LinearLayout
        android:id="@+id/section1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#0E131F"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step1Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 01 // STEP 1 : ENGINE ACTIVATION ]"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#38BDF8" />

        <TextView
            android:id="@+id/step1Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Enable Claviatura in system keyboard settings."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC" />

        <TextView
            android:id="@+id/step1Command"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="COMMAND: sys.ime --enable claviatura"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/step1Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="❯ Open Settings →"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#38BDF8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Step 2 Section -->
    <LinearLayout
        android:id="@+id/section2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#07090E"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step2Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 02 // STEP 2 : DEFAULT SELECTION ]"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/step2Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Select Claviatura as default input method."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/step2Command"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="COMMAND: sys.ime --set-default claviatura"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#475569" />

        <TextView
            android:id="@+id/step2Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="❯ Switch Keyboard →"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#64748B" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <!-- Step 3 Section -->
    <LinearLayout
        android:id="@+id/section3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_vertical"
        android:background="#07090E"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step3Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 03 // STEP 3 : CALIBRATION &amp; TEST ]"
            android:textSize="12sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/step3Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="All set! Start typing with Claviatura."
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#64748B" />

        <TextView
            android:id="@+id/step3Command"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="STATUS: READY FOR CALIBRATION &amp; BENCH"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:textColor="#475569" />

        <TextView
            android:id="@+id/step3Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="❯ Launch Settings →"
            android:textSize="13sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:textColor="#64748B" />
    </LinearLayout>

</LinearLayout>
