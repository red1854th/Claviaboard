<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/onboardingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF">

    <!-- Step 1 Section (Top 1/3) -->
    <LinearLayout
        android:id="@+id/section1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_vertical"
        android:background="#4C84F3"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step1Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/step1Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Claviatura 스위치를 켜주세요."
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/step1Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="→"
            android:textSize="32sp"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Step 2 Section (Middle 1/3) -->
    <LinearLayout
        android:id="@+id/section2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_vertical"
        android:background="#F8FAFC"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step2Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/step2Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="다음 화면에서\nClaviatura를 선택하세요."
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/step2Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="→"
            android:textSize="32sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#E2E8F0" />

    <!-- Step 3 Section (Bottom 1/3) -->
    <LinearLayout
        android:id="@+id/section3"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="28dp"
        android:gravity="center_vertical"
        android:background="#F8FAFC"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/step3Number"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/step3Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Claviatura가 준비되었습니다!"
            android:textSize="22sp"
            android:textStyle="bold"
            android:lineSpacingExtra="4dp"
            android:textColor="#94A3B8" />

        <TextView
            android:id="@+id/step3Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="→"
            android:textSize="32sp"
            android:textColor="#94A3B8" />
    </LinearLayout>

</LinearLayout>
