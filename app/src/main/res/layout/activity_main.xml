<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0D14"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ASCII Art Banner (Linux Ricing Style) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="  ___ _            _       _                 \n / __| |__ ___ _(_)__ _| |_ _  _ _ _ __ _ \n| (__| / _` \\ V / / _` |  _| || | '_/ _` |\n \\___|_\\__,_|\\_/|_\\__,_|\\__|\\_,_|_| \\__,_|"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.05"
                android:textColor="#38BDF8"
                android:textStyle="bold"
                android:gravity="center" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="══[ CLAVIATURA v2.5 // HANGUL &amp; EN IME ENGINE ]══"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:textColor="#94A3B8"
                android:gravity="center" />
        </LinearLayout>

        <!-- Neofetch / Fastfetch System Rice Info Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ RICE // SYSTEM STATUS ]"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#4ADE80" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="❯ HOST    : claviatura@archlinux-arm64"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="❯ ENGINE  : Zero-Alloc Hangul Automaton"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#E2E8F0" />

                <TextView
                    android:id="@+id/riceThemeBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="❯ THEME   : Catppuccin Mocha [Dark]"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#F472B6" />

                <TextView
                    android:id="@+id/riceConfigBadge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="❯ CONFIG  : ~/.config/claviatura/rice.conf"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#FBBF24" />
            </LinearLayout>
        </LinearLayout>

        <!-- IME Activation Banner (Only shown if NOT yet enabled or NOT default) -->
        <LinearLayout
            android:id="@+id/activationPromptCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1B4B"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:visibility="gone"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ ! ] ACTION REQUIRED: INITIALIZE IME"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#F43F5E" />

            <TextView
                android:id="@+id/activationDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="$ claviatura-setup --enable &amp;&amp; --set-default"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#CBD5E1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/enableImeButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="1. 키보드 활성화"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:backgroundTint="#3B82F6"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/selectImeButton"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="2. 기본 키보드 선택"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:backgroundTint="#6366F1"
                    android:textColor="#FFFFFF" />
            </LinearLayout>
        </LinearLayout>

        <!-- Interactive Live Terminal Typing Sandbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[ 00 // LIVE TERMINAL SANDBOX ]"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />

                <TextView
                    android:id="@+id/clearSandboxButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ CLEAR ]"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sandboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#0A0D14"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❯ "
                    android:fontFamily="monospace"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80" />

                <EditText
                    android:id="@+id/testEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="타이핑 테스트..."
                    android:textColorHint="#475569"
                    android:textColor="#F8FAFC"
                    android:textSize="14sp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />
            </LinearLayout>

            <Button
                android:id="@+id/focusKeyboardButton"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginTop="8dp"
                android:text="[ 키보드 열기 및 즉시 테스트 ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#1E293B"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <!-- Section 1: GEOMETRY & SIZING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 01 // GEOMETRY &amp; SIZING ]"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#A78BFA"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <!-- Keyboard Height -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="keyboard_height"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/heightValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="240dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/heightSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="180"
                android:progress="60" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Bottom Margin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="margin_bottom"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/bottomMarginValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/bottomMarginSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="60"
                android:progress="0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Side Margin -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="margin_horizontal"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/horizontalMarginValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/horizontalMarginSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="40"
                android:progress="0" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Key Corner Radius -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="key_corner_radius"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/cornerRadiusValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="6dp"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/cornerRadiusSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="24"
                android:progress="6" />
        </LinearLayout>

        <!-- Section 2: TIMINGS & TOUCH -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 02 // TIMINGS &amp; GESTURES ]"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#FBBF24"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <!-- Long Press Timeout -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="long_press_delay"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/longPressValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="280ms"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/longPressSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="50"
                android:progress="18" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Continuous Delete Hold Delay -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="backspace_hold_delay"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/deleteHoldValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="300ms"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/deleteHoldSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="50"
                android:progress="20" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Delete Repeat Interval -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="backspace_repeat_rate"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <TextView
                    android:id="@+id/deleteRepeatValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="45ms"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#FBBF24" />
            </LinearLayout>
            <SeekBar
                android:id="@+id/deleteRepeatSeekBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:max="80"
                android:progress="25" />
        </LinearLayout>

        <!-- Section 3: HAPTICS & SOUND -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 03 // HAPTICS &amp; SOUND ]"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#F472B6"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <!-- Vibration Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="haptic_feedback"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <Switch
                    android:id="@+id/vibrateSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- Vibration Strength -->
            <LinearLayout
                android:id="@+id/vibrateStrengthContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="vibration_strength"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textColor="#94A3B8" />
                    <TextView
                        android:id="@+id/vibrateStrengthValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:fontFamily="monospace"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#F472B6" />
                </LinearLayout>
                <SeekBar
                    android:id="@+id/vibrateStrengthSeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:max="100"
                    android:progress="30" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Sound Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="audio_click_sound"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <Switch
                    android:id="@+id/soundSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 4: LAYOUT & PREVIEW -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 04 // LAYOUT &amp; PREVIEW ]"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#4ADE80"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <!-- Show Number Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="show_top_number_row"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <Switch
                    android:id="@+id/showNumberRowSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Show Period Key -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="show_period_key"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <Switch
                    android:id="@+id/showPeriodKeySwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E2433"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- Show Key Preview Popup -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="show_key_preview_popup"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0" />
                <Switch
                    android:id="@+id/showKeyPreviewSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section 5: RICE THEMES -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 05 // RICE THEMES ]"
            android:fontFamily="monospace"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#121620"
            android:padding="14dp"
            android:layout_marginBottom="28dp">

            <RadioGroup
                android:id="@+id/themeRadioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RadioButton
                    android:id="@+id/themeDarkRadio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="dark       // Catppuccin Mocha"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="#E2E8F0"
