<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#07090E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Editorial Masthead / Technical Analog Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E131F"
            android:padding="16dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="CLAVIATURA"
                    android:fontFamily="monospace"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● READY // 60HZ"
                    android:fontFamily="monospace"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80"
                    android:background="#152338"
                    android:paddingStart="6dp"
                    android:paddingEnd="6dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="SPECIFICATION &amp; CALIBRATION CONTROL INTERFACE"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:letterSpacing="0.05"
                android:textColor="#38BDF8" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ENGINE: v2.5.0\nKERNEL: HANGUL-IME"
                    android:fontFamily="monospace"
                    android:textSize="9sp"
                    android:textColor="#64748B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="INPUT: DUAL-LANG\nTRANSDUCER: HAPTIC"
                    android:fontFamily="monospace"
                    android:textSize="9sp"
                    android:textColor="#64748B" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="LATENCY: &lt;10MS\nBUILD: 2026.08"
                    android:fontFamily="monospace"
                    android:textSize="9sp"
                    android:textColor="#64748B" />
            </LinearLayout>
        </LinearLayout>

        <!-- 00: Input Method & Language Engine Configuration -->
        <LinearLayout
            android:id="@+id/btnLanguageSettings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E131F"
            android:padding="16dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[ 00 // INPUT METHOD &amp; KEYBOARDS ]"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CONFIG ❯"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#1E293B"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/mainKoreanLayoutBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="❯ KOREAN  : Dubeolshik (Standard)"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#E2E8F0" />

            <TextView
                android:id="@+id/mainEnglishLayoutBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="❯ ENGLISH : QWERTY (Standard)"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#94A3B8" />

            <TextView
                android:id="@+id/riceThemeBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="❯ THEME   : Catppuccin Mocha [Dark]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textColor="#F472B6" />
        </LinearLayout>

        <!-- Live Terminal Sandbox -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="[ LIVE BUFFER &amp; INPUT BENCH ]"
                    android:fontFamily="monospace"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#38BDF8" />

                <TextView
                    android:id="@+id/clearSandboxButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="[ FLUSH BUFFER ]"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:textColor="#94A3B8"
                    android:padding="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/sandboxContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#07090E"
                android:padding="12dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="❯ "
                    android:fontFamily="monospace"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#4ADE80" />

                <EditText
                    android:id="@+id/testEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:fontFamily="monospace"
                    android:hint="Type here to test keyboard engine..."
                    android:textColorHint="#475569"
                    android:textColor="#F8FAFC"
                    android:textSize="12sp"
                    android:inputType="textMultiLine"
                    android:maxLines="3" />
            </LinearLayout>

            <Button
                android:id="@+id/focusKeyboardButton"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:layout_marginTop="8dp"
                android:text="[ ENGAGE SOFT INPUT KEYBOARD ]"
                android:fontFamily="monospace"
                android:textSize="10sp"
                android:backgroundTint="#152338"
                android:textColor="#38BDF8" />
        </LinearLayout>

        <!-- 01: KEYBOARD KEYS & VISIBILITY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 01 // KEYBOARD MATRIX &amp; VISIBILITY ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#38BDF8"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SPEC.MATRIX: DEDICATED NUM_ROW / PUNCTUATION / SYMBOLS"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#64748B"
                android:layout_marginBottom="10dp" />

            <Button
                android:id="@+id/btnToggleNumberRow"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  SPEC: NUMBER ROW ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleSpecialKey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  SPEC: SPECIAL KEY (@/SYM) ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnTogglePeriodKey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  SPEC: PERIOD KEY (.) ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleVoiceKey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  SPEC: VOICE &amp; HANJA ACTION (漢) ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleEmojiKey"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  SPEC: EMOJI &amp; SYMBOL MODE ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80" />
        </LinearLayout>

        <!-- 02: GEOMETRY & SIZING -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 02 // GEOMETRY &amp; SPATIAL CALIBRATION ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#A78BFA"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderKeyboardHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderHorizontalMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderBottomMargin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderKeyCornerRadius"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 03: TYPING BEHAVIOR & ENGINE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 03 // TYPING BEHAVIOR &amp; AUTOMATA ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#F59E0B"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnToggleSystemFont"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ○ OFF |  ENGINE: SYSTEM FONT ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#0E131F"
                android:textColor="#94A3B8"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleKeyPreview"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  ENGINE: CIRCULAR KEY PREVIEW ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleNumberRowLandscape"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  ENGINE: NUM ROW IN LANDSCAPE ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleDoubleSpacePeriod"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  ENGINE: DOUBLE SPACE PERIOD (.) ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleAutoCapitalize"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ○ OFF |  ENGINE: AUTO CAPITALIZE FIRST ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#0E131F"
                android:textColor="#94A3B8"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnToggleDoubleConsonant"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  ENGINE: DOUBLE TAP TENSE (ㄱ+ㄱ->ㄲ) ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80" />
        </LinearLayout>

        <!-- 04: TIMINGS & SENSITIVITY -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 04 // TIMINGS &amp; TRANSIENT RESPONSE ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#EC4899"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderCursorSensitivity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderLongPressTimeout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderDeleteHoldDelay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderDeleteRepeatInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 05: NUMBER KEYPAD TYPE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 05 // NUMERIC KEYPAD TOPOLOGY ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#14B8A6"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOPOLOGY: SELECT NUMBER/SYMBOL MATRIX MODE"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#64748B"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnNumberKeypadLinked"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="[ LINKED ]"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#152338"
                    android:textColor="#38BDF8" />

                <Button
                    android:id="@+id/btnNumberKeypad3x4"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:text="[ 3x4 PIN ]"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#0E131F"
                    android:textColor="#94A3B8" />

                <Button
                    android:id="@+id/btnNumberKeypadQwerty"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:text="[ QWERTY ]"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#0E131F"
                    android:textColor="#94A3B8" />
            </LinearLayout>
        </LinearLayout>

        <!-- 06: HAPTIC & AUDIO ENGINE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 06 // HAPTIC &amp; ACOUSTIC TRANSDUCER ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#6366F1"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="14dp">

            <Button
                android:id="@+id/btnToggleSound"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ○ OFF |  ACOUSTIC: SOUND SYNTHESIS ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#0E131F"
                android:textColor="#94A3B8"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PROFILE // TRANSDUCER ACOUSTIC WAVEFORM"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <Button
                    android:id="@+id/btnSoundMech"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="MECH"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#152338"
                    android:textColor="#38BDF8" />

                <Button
                    android:id="@+id/btnSoundPop"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="POP"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#0E131F"
                    android:textColor="#94A3B8" />

                <Button
                    android:id="@+id/btnSoundTypewriter"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="3dp"
                    android:text="TYPE"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#0E131F"
                    android:textColor="#94A3B8" />

                <Button
                    android:id="@+id/btnSoundTerminal"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="BEEP"
                    android:fontFamily="monospace"
                    android:textSize="10sp"
                    android:backgroundTint="#0E131F"
                    android:textColor="#94A3B8" />
            </LinearLayout>

            <Button
                android:id="@+id/btnToggleVibrate"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ● ON  |  HAPTIC: MOTOR VIBRATION ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#152338"
                android:textColor="#4ADE80"
                android:layout_marginBottom="10dp" />

            <com.example.claviatura.TerminalSliderBarView
                android:id="@+id/sliderVibrateStrength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- 07: APPEARANCE & DARK MODE -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 07 // CHROMATIC PALETTE &amp; THEME ]"
            android:fontFamily="monospace"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#F472B6"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#0E131F"
            android:padding="14dp"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnToggleDarkModeAuto"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="[ ○ OFF |  THEME: FOLLOW SYSTEM DARK ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:backgroundTint="#0E131F"
                android:textColor="#94A3B8"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="PALETTE // ANALOG &amp; EDITORIAL COLOR WAYS"
                android:fontFamily="monospace"
                android:textSize="9sp"
                android:textColor="#94A3B8"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="4dp">

                    <Button
                        android:id="@+id/btnThemeDark"
                        android:layout_width="0dp"
                        android:layout_height="36dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
