<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="[ LIVE IME SANDBOX // TEST INPUT ]"
        android:fontFamily="monospace"
        android:textColor="#38BDF8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_dialog_input"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="❯ "
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:textColor="#4ADE80"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/dialogEditText"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@null"
            android:fontFamily="monospace"
            android:hint="Type here to test current layout..."
            android:textColor="#F8FAFC"
            android:textColorHint="#475569"
            android:textSize="13sp" />
    </LinearLayout>

    <Button
        android:id="@+id/dialogCloseButton"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:layout_marginTop="16dp"
        android:backgroundTint="#1E293B"
        android:fontFamily="monospace"
        android:text="[ DONE ]"
        android:textColor="#38BDF8"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
