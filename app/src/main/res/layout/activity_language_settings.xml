<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#07090E">

    <!-- Top Action Bar (Editorial Spec Header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#0E131F"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ ❮ BACK ]"
            android:fontFamily="monospace"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[ INPUT METHODS &amp; ENGINES ]"
            android:fontFamily="monospace"
            android:textColor="#F8FAFC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/testKeyboardButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ BENCH ]"
            android:fontFamily="monospace"
            android:textColor="#4ADE80"
            android:textSize="11sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1E293B" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ 01 // ACTIVE LANGUAGE ENGINES ]"
                android:fontFamily="monospace"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#A78BFA"
                android:layout_marginBottom="8dp" />

            <!-- Korean Layout Card -->
            <LinearLayout
                android:id="@+id/koreanCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0E131F"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="12dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❯ [ 01 // KOREAN IME ENGINE ]"
                        android:fontFamily="monospace"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHANGE ❯"
                        android:fontFamily="monospace"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/koreanLayoutName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="LAYOUT: Dubeolshik (Standard)"
                    android:fontFamily="monospace"
                    android:textColor="#4ADE80"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SPEC: 2-Set Hangul Automaton / Tense Consonant Double-Tap"
                    android:fontFamily="monospace"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- English Layout Card -->
            <LinearLayout
                android:id="@+id/englishCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0E131F"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="❯ [ 02 // ENGLISH IME ENGINE ]"
                        android:fontFamily="monospace"
                        android:textColor="#F8FAFC"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHANGE ❯"
                        android:fontFamily="monospace"
                        android:textColor="#38BDF8"
                        android:textSize="10sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/englishLayoutName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="LAYOUT: QWERTY (Standard)"
                    android:fontFamily="monospace"
                    android:textColor="#4ADE80"
                    android:textSize="11sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="SPEC: ANSI / ISO Standard Topology / Auto-Capitalize"
                    android:fontFamily="monospace"
                    android:textColor="#64748B"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Add Language Engine Button Card -->
            <LinearLayout
                android:id="@+id/addLanguageCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#0E131F"
                android:orientation="vertical"
                android:padding="14dp"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="[ + ] ADD SECONDARY LANGUAGE ENGINE"
                    android:fontFamily="monospace"
                    android:textColor="#38BDF8"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:gravity="center" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="PACKS: JA-JP (Kana/Romaji), ZH-CN (Pinyin), ES-ES, FR-FR, DE-DE"
                    android:fontFamily="monospace"
                    android:textColor="#64748B"
                    android:textSize="9sp"
                    android:gravity="center" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
