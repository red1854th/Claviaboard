<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0D14">

    <!-- Top Action Bar (Terminal Rice Header) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="#121620"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ &lt; BACK ]"
            android:fontFamily="monospace"
            android:textColor="#38BDF8"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />

        <TextView
            android:id="@+id/titleTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="[ LAYOUT // ENGINE ]"
            android:fontFamily="monospace"
            android:textColor="#F8FAFC"
            android:textSize="13sp"
            android:textStyle="bold"
            android:gravity="center"
            android:paddingEnd="8dp" />

        <TextView
            android:id="@+id/testKeyboardButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ TEST ]"
            android:fontFamily="monospace"
            android:textColor="#4ADE80"
            android:textSize="12sp"
            android:textStyle="bold"
            android:padding="6dp"
            android:background="?attr/selectableItemBackground" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/sectionSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="[ SELECT DESIRED INPUT SCHEME ]"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="#A78BFA"
                android:layout_marginBottom="12dp" />

            <!-- Dynamic Layout Cards Container -->
            <LinearLayout
                android:id="@+id/layoutGridContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
